{
  // Base lefthook configuration for all repos
  // Extend this in your repo:
  // {
  //   "remotes": [
  //     {
  //       "configs": ["lefthook.jsonc"],
  //       "git_url": "https://github.com/dmikalova/project-standards",
  //       "ref": "main",
  //       "refetch": true,
  //     },
  //   ],
  // }

  // Disable TTY spinner to prevent cursor position report escape sequences
  // from leaking into terminal output
  "no_tty": true,

  "commit-msg": {
    "commands": {
      // The Go commitlint with the generated .commitlint.yaml (ADR 0004), via
      // project-standards: the copy dotfiles installs on PATH when it knows
      // commit-msg, otherwise the latest release through go run.
      "commitlint": {
        "run": "if project-standards help 2>/dev/null | grep -q commit-msg; then project-standards commit-msg {1}; else go run github.com/dmikalova/project-standards/cmd/project-standards@latest commit-msg {1}; fi",
      },
    },
  },

  "pre-commit": {
    "exclude": ["node_modules/**", "LICENSE", ".terraform/**"],
    "files": "git ls-files",
    "parallel": true,
    "commands": {
      "deno-check": {
        "run": "deno run check",
        "skip": [
          {
            "run": "! git ls-files 'deno.json*' | grep -q .",
          },
        ],
      },

      "deno-fmt": {
        "run": "deno run fmt",
        "skip": [
          {
            "run": "! git ls-files 'deno.json*' | grep -q .",
          },
        ],
      },

      "deno-lint": {
        "run": "deno run lint --fix",
        "skip": [
          {
            "run": "! git ls-files 'deno.json*' | grep -q .",
          },
        ],
      },

      "deno-test": {
        "run": "deno run test",
        "skip": [
          {
            "run": "! git ls-files '*_test.ts' '*.test.ts' '*_test.js' '*.test.js' | grep -q .",
          },
        ],
      },

      "deno-coverage": {
        "run": "NO_COLOR=1 deno task test:all --coverage 2>&1 | tee /dev/stderr | grep '| All files' | grep -q '100.0.*100.0.*100.0'",
        "skip": [
          {
            "run": "! git ls-files '*_test.ts' '*.test.ts' | grep -q .",
          },
        ],
      },

      // TypeScript on Node (ADR 0008): package.json and no deno.json. Vite+
      // runs format, lint and type checks, then Vitest, with the project's
      // own vite.config.ts.
      "node-check": {
        "run": "vp check --fix",
        "stage_fixed": true,
        "skip": [
          {
            "run": "! git ls-files package.json | grep -q . || git ls-files 'deno.json*' | grep -q .",
          },
        ],
      },

      "node-test": {
        "run": "vp test",
        "skip": [
          {
            "run": "! git ls-files package.json | grep -q . || git ls-files 'deno.json*' | grep -q .",
          },
        ],
      },

      // A Go repo whose magefiles import project-standards' ci package runs
      // the full verify-only gate (ADR 0003): formatting, build, vet, lint,
      // markdown, spelling, secrets, commits, tests and coverage. The hooks
      // below that ci:check already covers stand down in those repos. Repos
      // with magefiles that don't import ci yet keep their own `mage check`.
      "go-check": {
        "run": "if git grep -q 'mage:import ci' -- 'magefile.go' 'magefiles/*.go'; then mage ci:check; else mage check; fi",
        "skip": [
          {
            "run": "! git ls-files 'magefile.go' 'magefiles/*.go' | grep -q .",
          },
        ],
      },

      // Projects without go.mod get the same shared checks (markdown,
      // spelling, secrets, commit messages, generated-config drift) from the
      // project-standards binary: the copy dotfiles installs on PATH when it
      // knows check, otherwise the latest release through go run.
      "shared-check": {
        "run": "if project-standards help 2>/dev/null | grep -q commit-msg; then project-standards check; else go run github.com/dmikalova/project-standards/cmd/project-standards@latest check; fi",
        "skip": [
          {
            "run": "git ls-files 'go.mod' | grep -q .",
          },
        ],
      },

      "no-large-files": {
        "run": "files=$(git ls-files | xargs -I{} find {} -size +5M 2>/dev/null); [ -n \"$files\" ] && echo \"Error: Files exceed 5MB:\" && echo \"$files\" && exit 1 || exit 0",
      },

      "no-merge-conflicts": {
        "run": "git --no-pager grep -E '^(<<<<<<<|=======|>>>>>>>)' && exit 1 || exit 0",
      },

      // glob and {files} rather than git ls-files, so lefthook's own exclude
      // applies: a project that must ship shell, such as den's mgmt exec
      // bodies, lists the paths under tools.lefthook in mklv.config.json.
      "no-shell-scripts": {
        "glob": "*.sh",
        "run": "printf '%s\\n' {files}; echo 'Error: Shell scripts (.sh) are not allowed. Use TypeScript instead.'; exit 1",
      },

      // Format the staged OpenTofu and Terramate files and restage them, so a
      // commit is always formatted (cicd's check fails on unformatted files).
      "tofu-fmt": {
        "glob": ["*.tf", "**/*.tf", "*.tofu", "**/*.tofu"],
        "run": "tofu fmt {staged_files}",
        "stage_fixed": true,
      },

      "terramate-fmt": {
        "glob": ["*.tm.hcl", "**/*.tm.hcl"],
        "run": "terramate fmt",
        "stage_fixed": true,
        "skip": [
          {
            "run": "! git ls-files 'terramate.tm.hcl' | grep -q .",
          },
        ],
      },

      "tofu-validate": {
        "glob": ["**/*.tf", "**/*.tofu"],
        "run": "terramate run -- tofu validate",
        "skip": [
          {
            "run": "! git ls-files '*.tf' '*.tofu' '*tm.hcl' | grep -q .",
          },
        ],
      },
    },
  },
}
